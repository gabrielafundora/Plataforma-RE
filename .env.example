# Local Postgres for dev (see docs/schema/README.md). Production runs on
# Neon — this is the only line that changes, schema.sql runs on vanilla
# Postgres either way. In production, DATABASE_URL must also be exposed
# at BUILD time in Vercel's project settings, not just runtime: the
# "vercel-build" script applies docs/schema/migrations/ before `next
# build` (see docs/schema/README.md's "Cómo se mantiene al día…").
DATABASE_URL=postgres://localhost:5432/re_os_dev
