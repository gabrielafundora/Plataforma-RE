    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.4",
    "tsx": "4.23.12",
    "typescript": "5.5.3",
    "vitest": "4.1.11"
